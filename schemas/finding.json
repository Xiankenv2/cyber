{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentryBox Finding",
  "type": "object",
  "required": ["id", "severity", "message", "file"],
  "properties": {
    "id": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "message": { "type": "string" },
    "file": { "type": "string" },
    "line": { "type": "integer" },
    "col": { "type": "integer" },
    "snippet": { "type": "string" },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  }
}
