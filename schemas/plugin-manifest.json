{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentryBox Plugin Manifest",
  "type": "object",
  "required": ["id", "version", "name", "author", "capabilities"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\.]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["fs_read", "network_client", "env_read"]
      }
    },
    "tier": {
      "type": "string",
      "enum": ["standard", "native-fast"],
      "default": "standard"
    }
  }
}
